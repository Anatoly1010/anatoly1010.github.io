@article{10.26599/POM.2026.9140171,
    author = {Chen, Wei-Peng and Zhai, Yuan-Qi and Luo, Qian-Cheng and Ding, Xia-Li and Melnikov, Anatoly R. and Veber, Sergey L. and Neugebauer, Petr and van Slageren, Joris and Dai, Yingqiu and Su, Ji-Hu and Rong, Xing and Wang, Zhenxing and Ouyang, Zhongwen and Diaz-Ortega, Ismael Francisco and Nojiri, Hiroyuki and Zheng, Yan-Zhen},
    title = {A high-nuclearity vanadium(III,IV) cyclic coordination cluster with small ground spin state},
    journal = {Polyoxometalates},
    year = {2026},
    month = {10},
    issn = {2957-9503},
    abstract = {Low-valent vanadium(III) with d2 electronic configuration, which can generate significant magnetic anisotropy, is highly desirable for the construction of high-performance molecule-based magnetic materials. Such lightweight and flexible magnetic materials cannot be realized by conventional inorganic or alloy-based permanent magnets. However, owing to the facile oxidation of vanadium(III), the synthesis of stable complexes containing highly reduced V(III) or mixed low-valent V(III,IV) centers remains extremely challenging. To date, only a limited number of V(III) or V(III,IV)-based coordination complexes or clusters have been isolated, most of which possess a nuclearity lower than eighteen. Herein, we report the self-assembly of a giant V(III,IV) cluster, namely {VIII20VIV2O8(OH)8(CH3COO)24(CH3CH2O)20}·5CH3CH2OH (V22), from a trinuclear vanadium precursor. The resulting large V22 cyclic coordination cluster exhibits an unusual small triplet ground spin state, which arises from antiferromagnetic exchange interactions. Moreover, this cluster system is detectable by electron paramagnetic resonance (EPR) spectroscopy and displays prominent quantum characteristics.},
    doi = {10.26599/POM.2026.9140171},
    url = {https://doi.org/10.26599/POM.2026.9140171},
}
