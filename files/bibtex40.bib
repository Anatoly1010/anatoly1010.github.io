@article{10.1007/s11172-026-5066-3,
    author = {Kuznetsov, D. A. and Zakirov, A. M. and Medved’ko, A. V. and Melnikov, A. R. and Bagryanskaya, E. G. and Vatsadze, S. Z.},
    title = {Linker effect on the exchange and dipolar coupling in TEMPO-based radicals and diradicals},
    journal = {Russian Chemical Bulletin},
    volume = {75},
    number = {7},
    pages = {2177--2184},
    year = {2026},
    month = {07},
    issn = {1573-9171},
    abstract = {TEMPO-based mono- and diradicals were studied by EPR spectroscopy in liquid (300 K) and frozen (80 K) solutions. Quantum chemical calculations of various conformations of the diradicals were performed. The hyperfine coupling constants and exchange constants of the diradicals were obtained by comparing the experimental and simulated EPR spectra. The strength of dipole-dipole interaction between the unpaired electrons in the diradicals was evaluated using the average distance between the radical centers. The X-band electron spin relaxation times were measured. It was concluded that diradicals can be used as polarizing agents for dynamic nuclear polarization.},
    doi = {10.1007/s11172-026-5066-3},
    url = {https://doi.org/10.1007/s11172-026-5066-3},
}
